#!/bin/bash
# Build a birthday profile from the two school exports, or switch between profiles.
SELF="${BASH_SOURCE[0]}"; while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
BASE="$(cd "$(dirname "$SELF")/../../.." && pwd)"
RES="$BASE/Birthday Reminder.app/Contents/Resources"
IMPORT="$RES/import.py"

say()   { osascript -e "display alert \"Student Birthdays\" message \"$1\"" >/dev/null 2>&1; }
fail()  { osascript -e "display alert \"Student Birthdays\" message \"$1\" as critical" >/dev/null 2>&1; exit 1; }
ask()   { osascript -e "text returned of (display dialog \"$1\" default answer \"$2\" with title \"Student Birthdays\")" 2>/dev/null; }
pick()  { osascript -e "POSIX path of (choose file with prompt \"$1\")" 2>/dev/null; }
choose(){ osascript -e "choose from list {$1} with prompt \"$2\" with title \"Student Birthdays\"" 2>/dev/null; }
yesno() { osascript -e "button returned of (display dialog \"$1\" buttons {\"$3\",\"$2\"} default button \"$2\" with title \"Student Birthdays\")" 2>/dev/null; }

[ -f "$IMPORT" ] || fail "Cannot find import.py. Keep this app in the same folder as Birthday Reminder.app."

# ---------------------------------------------------------------- find a python3
PY=""
for c in /usr/bin/python3 /usr/local/bin/python3 /opt/homebrew/bin/python3; do
  [ -x "$c" ] && "$c" -c 'import sys,zipfile,struct' >/dev/null 2>&1 && { PY="$c"; break; }
done
[ -z "$PY" ] && command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1 && PY="python3"
if [ -z "$PY" ]; then
  A="$(yesno "Reading Excel files needs Python, which macOS installs as part of its command line tools. This is a one-time, official Apple download.\n\nInstall it now, then open this app again." "Install" "Not now")"
  [ "$A" = "Install" ] && xcode-select --install >/dev/null 2>&1
  exit 1
fi

# ---------------------------------------------------------------- import or switch
ACTIVE=""; [ -f "$BASE/active_profile" ] && ACTIVE="$(head -n1 "$BASE/active_profile" | tr -d '\r\n')"
EXISTING=()
if [ -d "$BASE/Profiles" ]; then
  while IFS= read -r d; do [ -n "$d" ] && EXISTING+=("$(basename "$d")"); done \
    < <(find "$BASE/Profiles" -mindepth 1 -maxdepth 1 -type d | sort)
fi

if [ ${#EXISTING[@]} -gt 0 ]; then
  LIST='"Import a new class…"'
  for e in "${EXISTING[@]}"; do LIST="$LIST, \"Switch to: $e\""; done
  SEL="$(choose "$LIST" "You currently have: ${ACTIVE:-none}. What would you like to do?")"
  [ -z "$SEL" ] || [ "$SEL" = "false" ] && exit 0
  case "$SEL" in
    "Switch to: "*) printf '%s\n' "${SEL#Switch to: }" > "$BASE/active_profile"
                    "$BASE/Birthday Reminder.app/Contents/MacOS/build-calendar" >/dev/null 2>&1
                    say "Now showing: ${SEL#Switch to: }"; exit 0 ;;
  esac
fi

# ---------------------------------------------------------------- gather the inputs
REPORT="$(pick "Choose your Student Report - Custom Reports, with every field ticked")"
[ -z "$REPORT" ] && exit 0
[ -f "$REPORT" ] || fail "That file could not be read."

BADGES="-"
if [ "$(yesno "Do you also have the Student ID Badge export? That is where the photographs come from." "Yes, choose it" "Skip photos")" = "Yes, choose it" ]; then
  BADGES="$(pick "Choose the Student ID Badge file - Custom Reports")"
  [ -z "$BADGES" ] && BADGES="-"
fi

EXTRA=""
if [ "$(yesno "Do you also have the Export Wizard file? That is the only one with the preferred names on it." "Yes, choose it" "Skip it")" = "Yes, choose it" ]; then
  EXTRA="$(pick "Choose the Export Wizard file (usually called export.xlsx)")"
fi

INITIALS=""
CODES="$("$PY" "$IMPORT" --initials "$REPORT" 2>/dev/null | head -40)"
if [ -n "$CODES" ]; then
  LIST=""
  while IFS=$'\t' read -r code n; do
    [ -n "$code" ] && LIST="$LIST${LIST:+, }\"$code  ($n students)\""
  done <<< "$CODES"
  SEL="$(choose "$LIST, \"None of these\"" "Which tutor initials are yours? Your own tutees get marked in the app.")"
  [ "$SEL" != "false" ] && [ "$SEL" != "None of these" ] && INITIALS="${SEL%% *}"
fi
[ -z "$INITIALS" ] && INITIALS="$(ask "Your initials, as the school writes them (leave blank to skip):" "")"
INITIALS="$(printf '%s' "$INITIALS" | tr -d ' \r\n' | tr '[:lower:]' '[:upper:]')"

YEAR="$(ask "A name for this set of students:" "${INITIALS:+$INITIALS }$(date +%Y)-$(( 10#$(date +%y) + 1 ))")"
[ -z "$YEAR" ] && exit 0
NAME="$(printf '%s' "$YEAR" | tr '/:' '--' | sed 's/^ *//;s/ *$//')"
OUT="$BASE/Profiles/$NAME"
if [ -d "$OUT" ] && [ "$(yesno "\"$NAME\" already exists. Replace its students and photos?\n\nAny preferred names you typed in will be kept." "Replace" "Cancel")" != "Replace" ]; then exit 0; fi
mkdir -p "$OUT"

# ---------------------------------------------------------------- run it
LOG="$("$PY" "$IMPORT" "$REPORT" "$BADGES" "$OUT" "$INITIALS" ${EXTRA:+"$EXTRA"} 2>&1)"
if ! printf '%s' "$LOG" | grep -q '^OK '; then
  fail "Import failed.$(printf '\n\n')$(printf '%s' "$LOG" | tail -6 | sed 's/"/\\"/g')"
fi

printf '%s\n' "$NAME" > "$BASE/active_profile"
"$BASE/Birthday Reminder.app/Contents/MacOS/build-calendar" >/dev/null 2>&1

SUMMARY="$(printf '%s' "$LOG" | sed 's/^INFO /• /;s/^WARN /! /;s/^OK /Done: /' | sed 's/"/\\"/g' | tr '\n' '@' | sed 's/@/\\n/g')"
BTN="$(osascript -e "button returned of (display dialog \"$NAME is now the active set.\n\n$SUMMARY\" buttons {\"Close\",\"Open the calendar\"} default button \"Open the calendar\" with title \"Student Birthdays\")" 2>/dev/null)"
if [ "$BTN" = "Open the calendar" ]; then
  # Go to the live calendar, not the read-only copy. `open` on the .html file hands it
  # to whatever browser is default, where switching classes and importing are all dead
  # because there is no helper behind them - which looks exactly like a broken page.
  MAC="$BASE/Birthday Reminder.app/Contents/MacOS"
  URL="$("$MAC/start-helper" "$BASE" 2>/dev/null)"
  [ -n "$URL" ] || URL="file://$BASE/Birthday Calendar.html"
  "$MAC/app-window" "$URL" 1280 900 >/dev/null 2>&1 &
fi
exit 0
